{
  "name": "rbxclistrap",
  "version": "4.0.0",
  "description": "A CLI alternative Roblox Player and Roblox Studio bootstrapper",
  "license": "GPL-3.0-only",
  "author": {
    "name": "xayanide"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "cli:base": "node index.cli.js",
    "cli:player": "npm run cli:base -- player",
    "cli:studio": "npm run cli:base -- studio",
    "format:base": "prettier .",
    "format:check": "npm run format:base -- --check",
    "format:write": "npm run format:base -- --write",
    "postinstall": "patch-package",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "style": "npm run lint:fix && npm run format:write",
    "start:base": "node index.js",
    "start:player": "npm run start:base -- player",
    "start:studio": "npm run start:base -- studio"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "axios": "^1.16.1",
    "patch-package": "^8.0.1",
    "regedit": "^5.1.3",
    "winston": "^3.19.0",
    "yocto-spinner": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@semantic-release/git": "^10.0.1",
    "@stylistic/eslint-plugin": "^4.4.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "3.8.3",
    "semantic-release": "^24.2.9",
    "typescript-eslint": "^8.60.1"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
